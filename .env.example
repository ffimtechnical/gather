# Copy to ".env" for local use. On Vercel: Project → Settings → Environment Variables.

# Required: your Neon connection string (Neon dashboard → Connect). Any Postgres URL also works.
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Optional: a code required only to create the very first admin on a fresh deploy.
FFIM_SETUP_CODE=

# Optional: sign-in token secret. If empty, one is generated and stored in the database.
FFIM_SECRET=

# --- AI assistant (all free; add at least one) ---
# Groq: console.groq.com → API Keys. Also powers voice (Whisper speech-to-text).
GROQ_API_KEY=
# Google Gemini: aistudio.google.com → Get API key. Used if Groq is busy.
GEMINI_API_KEY=
# OpenRouter: openrouter.ai → Keys. Free models, used as a last fallback.
OPENROUTER_API_KEY=
# Optional model overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=openrouter/free
